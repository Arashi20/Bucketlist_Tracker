# --- Required ---

# The main app's database. On Railway use the reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway

# Signs the OAuth tokens this connector issues. Any long random string; it does
# NOT need to match the main app's SECRET_KEY. Rotating it revokes every token
# this connector has handed out.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET_KEY=

# The login you use in the app. The app keeps it in these two variables rather
# than in a users table, so the approval page checks the same two. On Railway,
# reference the main service's values so they never drift apart:
#   APP_USERNAME=${{Bucketlist_Tracker.APP_USERNAME}}
#   APP_PASSWORD=${{Bucketlist_Tracker.APP_PASSWORD}}
APP_USERNAME=
APP_PASSWORD=

# --- Optional ---

# Decides what counts as "today" for upcoming vs past trips.
#APP_TIMEZONE=Europe/Amsterdam

# On Railway both of these default to the domain Railway injects, so leave them
# unset unless you serve the connector on a custom domain.
#MCP_PUBLIC_URL=https://connector.example.com
#MCP_ALLOWED_HOSTS=connector.example.com

# Static bearer token for curl or Claude Code. Comma-separate to rotate.
#API_READ_TOKEN=

# A pre-shared OAuth client, if you would rather paste credentials into Claude
# than let it register itself. Both are needed - a secret alone does nothing.
#MCP_OAUTH_CLIENT_ID=
#MCP_OAUTH_CLIENT_SECRET=
#MCP_OAUTH_CLIENT_NAME=Claude

# Set to 0 once connected to stop accepting new client registrations.
#MCP_OAUTH_ALLOW_DYNAMIC_REGISTRATION=1
