# --- Required: the app refuses to start without these ---
DATABASE_URL=postgresql://user:password@localhost:5432/bucketlist
# Signs login tokens. Long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
APP_PASSWORD=

# --- Optional ---
#APP_USERNAME=ash
#CORS_ORIGINS=http://localhost:5173
# Serve the interactive API docs at /docs (keep off in production).
#ENABLE_API_DOCS=1
# Log every SQL statement with its parameters (debugging only).
#SQL_ECHO=1
